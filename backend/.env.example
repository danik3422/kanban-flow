PORT=5001
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MONGO_URI=mongodb://127.0.0.1:27017/kanban
ALLOW_MEMORY_DB=false
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173


# Brevo transactional email API
MAIL_FROM=KanbanHub <noreply@kanbanhub.app>
MAIL_REPLY_TO=support@kanbanhub.app
# Optional development/test redirect for all outgoing emails
MAIL_REDIRECT_TO=
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Board background photos: full Unsplash search. Free key at https://unsplash.com/developers
# (Your apps > New application > Access Key). Without it a built-in set of 40 photos is used.
UNSPLASH_ACCESS_KEY=

# How often the "Hourly summary" email goes out, in minutes (default 60).
EMAIL_DIGEST_MINUTES=60

# --- Self-hosting and optional services --------------------------------------
# Email through any SMTP server instead of Brevo (needs MAIL_FROM).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# required | off; empty means "required only when email is set up" (always on locally).
EMAIL_VERIFICATION=
# closed: only the first account signs up itself; add others with npm run create-user.
SIGNUP=
# false: no online photo search for board backgrounds (servers without internet).
REMOTE_PHOTOS=true
# Where uploaded pictures go when Cloudinary is not configured (default: backend/uploads).
UPLOADS_DIR=
# Serve the built web app from this server (Docker sets it to /app/web).
FRONTEND_DIST=
# Secure cookies; defaults to on outside development. Plain-http self-hosting sets false.
COOKIE_SECURE=
