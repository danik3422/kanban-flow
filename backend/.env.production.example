NODE_ENV=production
PORT=10000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kanban
ALLOW_MEMORY_DB=false
CORS_ORIGIN=https://kanbanhub.app
FRONTEND_URL=https://kanbanhub.app

# SMTP
MAIL_FROM=KanbanHub <noreply@kanbanhub.app>
MAIL_REPLY_TO=support@kanbanhub.app
MAIL_REDIRECT_TO=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
