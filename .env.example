# KanbanHub self-hosting settings (docker compose reads this as .env).
# Everything is optional: with no changes the app runs at http://localhost:8080.

# --- Address -------------------------------------------------------------------
# Port on this machine.
PORT=8080
# The address people type to open KanbanHub. Use the server's network address
# (http://192.168.1.20:8080) or your domain (https://kanban.example.com).
# https:// turns on secure cookies; behind a reverse proxy also set TRUST_PROXY=1.
PUBLIC_URL=http://localhost:8080
# TRUST_PROXY=1

# --- Email (optional) ------------------------------------------------------------
# Without email: new accounts are ready at once (no confirmation), invites work by
# link, and the admin resets passwords:  docker compose exec app npm run reset-password -- name@example.com
# With email: confirmation, password reset links, invites and notifications by email.
# MAIL_FROM=KanbanHub <kanban@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Without internet --------------------------------------------------------------
# The server needs no internet. Turn off photo search for board backgrounds (people
# can still upload their own photos and pick colours):
# REMOTE_PHOTOS=false

# --- Pictures in Cloudinary instead of this server (optional) ----------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Google / Microsoft / Apple sign-in (optional, needs internet and Firebase) ----
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# FIREBASE_SERVICE_ACCOUNT=

# Sessions are signed with a random secret created on first start and kept in the
# app-data volume. To set your own (at least 32 characters):
# JWT_SECRET=
